<Page
    x:Class="App3.WebPage2"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App3"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    muxc:BackdropMaterial.ApplyToRootOrPageBackground="True"
    SizeChanged="Page_SizeChanged">

    <Grid>
        <Grid Name="EdgeLinkGrid" MinHeight="50" MaxHeight="50" Height="50" HorizontalAlignment="Stretch" Margin="0,0,0,50">
            <TextBox Name="LinkBox" x:Uid="A地址栏" FontFamily="HarmonyOS Sans SC" Height="32" HorizontalAlignment="Stretch" KeyDown="LinkChanged" TextCompositionStarted="LinkIME" GotFocus="LinkToChanging" LostFocus="LinkToChanged" IsSpellCheckEnabled="False" VerticalAlignment="Center" AllowDrop="True" AllowFocusOnInteraction="True"/>
        </Grid>
        <Grid Name="EdgeBottomBar" VerticalAlignment="Bottom" MinHeight="100" MaxHeight="100" Height="100" HorizontalAlignment="Stretch">
            <Button Height="38" Name="ButtonM_Refresh" Click="Refresh" x:Uid="O刷新" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,10,0">
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE149;" FontSize="16"/>
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F5"/>
                </Button.KeyboardAccelerators>
            </Button>
            <StackPanel Height="40" HorizontalAlignment="Center" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,6">
                <Button Name="ButtonM_Back" Click="Back" x:Uid="O返回" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="4,0,4,0">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE112;" FontSize="18"/>
                </Button>
                <Button Name="ButtonM_Forward" Click="Forward" x:Uid="O前进" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="4,0,4,0">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE111;" FontSize="18"/>
                </Button>
                <Button CornerRadius="20" Width="50" Height="40" Name="ButtonM_NewTab" Style="{StaticResource AccentButtonStyle}" Click="NewTab_Click" x:Uid="O新建标签页" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="12,0,12,0">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE109;" FontSize="22"/>
                </Button>
                <Button Name="ButtonM_TabList" Click="TabList_Click"  x:Uid="O标签页" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="4,0,4,0">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE175;" FontSize="18"/>
                </Button>
                <Button Name="ButtonM_More" Click="MoreButton_Click" x:Uid="A更多" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="4,0,4,0">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE10C;" FontSize="18"/>
                    <Button.Flyout>
                        <MenuFlyout Placement="TopEdgeAlignedRight" >
                            <MenuFlyoutItem x:Uid="T移动设备视图" Name="MobilePageButton" Visibility="Collapsed" Click="MobilePage_Click" FontFamily="HarmonyOS Sans SC">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8EA;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="T新建标签页" Click="NewTab_Click" FontFamily="HarmonyOS Sans SC">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEC6C;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="T新建窗口" Click="NewWindow_Click" FontFamily="HarmonyOS Sans SC">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE737;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="T在新窗口中打开" Click="NewWindowOpen_Click" FontFamily="HarmonyOS Sans SC">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE737;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="T全屏" Click="FullScreen" FontFamily="HarmonyOS Sans SC">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE740;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem x:Uid="T收藏夹" Click="Collection" FontFamily="HarmonyOS Sans SC">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE1CE;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="T笔记" Click="MoreMenuItem_Click" FontFamily="HarmonyOS Sans SC" Visibility="Collapsed">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70B;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="T历史记录" Click="History" FontFamily="HarmonyOS Sans SC">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE81C;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="T下载" Click="Download" FontFamily="HarmonyOS Sans SC">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE118;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem x:Uid="T设置" Click="Settings" FontFamily="HarmonyOS Sans SC">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE115;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>
        <Grid Name="EdgeTitleBar" VerticalAlignment="Top" MinHeight="50" MaxHeight="50" Height="50" HorizontalAlignment="Stretch">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="36">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Stretch">
                    <Button Name="Button_Back" Click="Back" x:Uid="O返回" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Stretch">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE112;" FontSize="16"/>
                    </Button>
                    <Button Name="Button_Forward" Click="Forward" x:Uid="O前进" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Stretch">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE111;" FontSize="16"/>
                    </Button>
                    <Button Name="Button_Refresh" Click="Refresh" x:Uid="O刷新" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Stretch">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE149;" FontSize="16"/>
                        <Button.KeyboardAccelerators>
                        </Button.KeyboardAccelerators>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Stretch">
                    <Button Name="CollectionButton" Click="Collection"  x:Uid="O收藏夹" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE1CE;" FontSize="16"/>
                    </Button>
                    <Button Name="HistoryButton" Click="History" x:Uid="O历史记录" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE81C;" FontSize="16"/>
                    </Button>
                    <Button Name="DownloadButton" Click="Download" x:Uid="O下载" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE118;" FontSize="16"/>
                    </Button>
                    <Button Name="FullScreenButton" x:Uid="O全屏" Click="FullScreen" Background="Transparent" BorderBrush="Transparent" Visibility="Collapsed" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE1D9;" FontSize="16"/>
                    </Button>
                    <Button Name="MoreButton" Click="MoreButton_Click" x:Uid="A更多" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE10C;" FontSize="16"/>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight" >
                                <MenuFlyoutItem x:Uid="T新建标签页" Click="NewTab_Click" FontFamily="HarmonyOS Sans SC" KeyboardAcceleratorTextOverride="Ctrl+T">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEC6C;"/>
                                    </MenuFlyoutItem.Icon>
                                    <MenuFlyoutItem.KeyboardAccelerators>
                                    </MenuFlyoutItem.KeyboardAccelerators>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Uid="T新建窗口" Click="NewWindow_Click" FontFamily="HarmonyOS Sans SC" KeyboardAcceleratorTextOverride="Ctrl+N">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE737;"/>
                                    </MenuFlyoutItem.Icon>
                                    <MenuFlyoutItem.KeyboardAccelerators>
                                    </MenuFlyoutItem.KeyboardAccelerators>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Uid="T在新窗口中打开" Click="NewWindowOpen_Click" FontFamily="HarmonyOS Sans SC">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE737;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Uid="T全屏" Click="FullScreen" FontFamily="HarmonyOS Sans SC">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE740;"/>
                                    </MenuFlyoutItem.Icon>
                                    <MenuFlyoutItem.KeyboardAccelerators>
                                    </MenuFlyoutItem.KeyboardAccelerators>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem x:Uid="T收藏夹" Click="Collection" FontFamily="HarmonyOS Sans SC" KeyboardAcceleratorTextOverride="Ctrl+O">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE1CE;"/>
                                    </MenuFlyoutItem.Icon>
                                    <MenuFlyoutItem.KeyboardAccelerators>
                                    </MenuFlyoutItem.KeyboardAccelerators>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Uid="T笔记" Click="MoreMenuItem_Click" FontFamily="HarmonyOS Sans SC" Visibility="Collapsed">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70B;"/>
                                    </MenuFlyoutItem.Icon>
                                    <MenuFlyoutItem.KeyboardAccelerators>
                                    </MenuFlyoutItem.KeyboardAccelerators>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Uid="T历史记录" Click="History" FontFamily="HarmonyOS Sans SC" KeyboardAcceleratorTextOverride="Ctrl+H">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE81C;"/>
                                    </MenuFlyoutItem.Icon>
                                    <MenuFlyoutItem.KeyboardAccelerators>
                                    </MenuFlyoutItem.KeyboardAccelerators>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Uid="T下载" Click="Download" FontFamily="HarmonyOS Sans SC" KeyboardAcceleratorTextOverride="Ctrl+J">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE118;"/>
                                    </MenuFlyoutItem.Icon>
                                    <MenuFlyoutItem.KeyboardAccelerators>
                                        <KeyboardAccelerator Key="J" Modifiers="Control"/>
                                    </MenuFlyoutItem.KeyboardAccelerators>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem x:Uid="T设置" Click="Settings" FontFamily="HarmonyOS Sans SC" KeyboardAcceleratorTextOverride="Ctrl+I">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE115;"/>
                                    </MenuFlyoutItem.Icon>
                                    <MenuFlyoutItem.KeyboardAccelerators>
                                    </MenuFlyoutItem.KeyboardAccelerators>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
        <Grid Name="NewTabPage">
            <TextBox FontFamily="HarmonyOS Sans SC"  Name="SearchBox" Height="48" FontSize="25" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="180,-128,180,0" KeyDown="SearchChanged" IsSpellCheckEnabled="True" x:Uid="P搜索网络" AllowDrop="True"/>
        </Grid>
        <muxc:WebView2 x:Name="EdgeWebView" VerticalAlignment="Top" Opacity="1" AllowDrop="True" Visibility="Visible" HorizontalAlignment="Stretch" CoreWebView2Initialized="EdgeWebView_CoreWebView2Initialized" Source="about:blank" Loaded="EdgeWebView_Loaded">
            <muxc:WebView2.KeyboardAccelerators>
            </muxc:WebView2.KeyboardAccelerators>
        </muxc:WebView2>
        <Grid>
            <muxc:ProgressBar Name="LoadingBar" Margin="0,46,0,98" HorizontalAlignment="Stretch" IsIndeterminate="True" ShowPaused="False" ShowError="False" />
        </Grid>
        <Grid VerticalAlignment="Top" HorizontalAlignment="Stretch">
            <Line Name ="SeparateLineLight" Stroke="LightGray" X1="0" StrokeThickness = "0.5"/>
            <Line Name ="SeparateLineDark" Stroke="Gray" X1="0" StrokeThickness = "0.5"/>
        </Grid>
    </Grid>
</Page>

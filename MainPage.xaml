<Page
    x:Class="App3.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App3"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    muxc:BackdropMaterial.ApplyToRootOrPageBackground="True"
    SizeChanged="Page_SizeChanged">

    <Grid>
        <muxc:TabView Name="MicrosoftEdge" FontFamily="HarmonyOS Sans SC" AddTabButtonClick="TabView_AddButtonClick" TabCloseRequested="TabView_TabCloseRequested" Loaded="TabView_Loaded" CloseButtonOverlayMode="OnPointerOver" HorizontalAlignment="Stretch" SelectionChanged="MicrosoftEdge_SelectionChanged" VerticalAlignment="Stretch">
            <muxc:TabView.Resources>
                <Storyboard x:Name="TitleStoryBoard">
                    <DoubleAnimation x:Name="TitleDTransform" Storyboard.TargetName="TitleBarTransform" Storyboard.TargetProperty="Y" From="0" To="0" Duration="0:0:0.4" >
                        <DoubleAnimation.EasingFunction>
                            <ExponentialEase Exponent="8" EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </muxc:TabView.Resources>
            <muxc:TabView.RenderTransform>
                <TranslateTransform x:Name="TitleBarTransform" X="0" Y="0"/>
            </muxc:TabView.RenderTransform>
            <muxc:TabView.TabStripHeader>
                <StackPanel Orientation="Horizontal">
                    <Image Source="Assets/WindowIcon.png" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Fill" MinWidth="16" MaxWidth="16" Width="16" MinHeight="16" MaxHeight="16" Height="16" Margin="12,11,12,12"/>
                    <Button Name="TabListButton" Click="TabListButton_Click" AutomationProperties.Name="标签页" ToolTipService.ToolTip="标签页" Background="Transparent" BorderBrush="Transparent" FontFamily="Segoe Fluent Icons" Content="&#xE700;" FontSize="16" Height="36" Width="38" VerticalAlignment="Center">
                    </Button>
                </StackPanel>
            </muxc:TabView.TabStripHeader>
            <muxc:TabView.TabStripFooter>
                <Grid Background="Transparent" x:Name="AppTitleBar" Margin="0,0,200,0"/>
            </muxc:TabView.TabStripFooter>
            <muxc:TabView.KeyboardAccelerators>
                <KeyboardAccelerator Key="T" Modifiers="Control" Invoked="NewTabKeyboardAccelerator_Invoked" />
                <KeyboardAccelerator Key="W" Modifiers="Control" Invoked="CloseSelectedTabKeyboardAccelerator_Invoked" />
                <KeyboardAccelerator Key="Escape" Invoked="EscKeyboardAccelerator_Invoked" />
            </muxc:TabView.KeyboardAccelerators>
        </muxc:TabView>
        <Button Name="ExitFS" IsTabStop="False" PointerEntered="ExitFS_PointerEntered" PointerMoved="ExitFS_PointerEntered" HorizontalAlignment="Stretch" VerticalAlignment="Top" Background="Transparent" Height="16" BorderThickness="0" Opacity="0" Visibility="Collapsed" />

        <Button x:Name="SideWindowBackground" IsTabStop="False" HorizontalAlignment="Stretch" ClickMode="Press" VerticalAlignment="Stretch" CornerRadius="0" Background="Transparent" BorderBrush="Transparent" Margin="0,90,0,0" Click="SideWindowBackground_Click" Visibility="Collapsed">
        </Button>
        <Grid x:Name="SideGrid" ManipulationDelta="SideGrid_ManipulationDelta" ManipulationMode="TranslateX" ManipulationCompleted="SideGrid_ManipulationCompleted" ManipulationStarted="SideGrid_ManipulationStarted" Margin="0,90,0,0" VerticalAlignment="Stretch" HorizontalAlignment="Right" Visibility="Collapsed" Opacity="1">
            <Grid.Resources>
                <Storyboard x:Name="SideStoryBoard">
                    <DoubleAnimation x:Name="SideFlowIn" Storyboard.TargetName="SideGridTransform" Storyboard.TargetProperty="X" From="0" To="0" Duration="0:0:0.4" >
                        <DoubleAnimation.EasingFunction>
                            <ExponentialEase Exponent="8" EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation x:Name="SideOpacity" From="1" To="1" Storyboard.TargetName="SideGrid" Storyboard.TargetProperty="Opacity" Duration="0:0:0.1" />
                </Storyboard>
            </Grid.Resources>
            <Grid.RenderTransform>
                <TranslateTransform x:Name="SideGridTransform" X="0" Y="0"/>
            </Grid.RenderTransform>
            <Frame Name="SideWindow" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
            </Frame>
            <AppBarSeparator Name="SideSeparateBar" Visibility="Collapsed" VerticalAlignment="Stretch" HorizontalAlignment="Left" Margin="-3,-8,-8,-8"/>
        </Grid>
        
        <Button x:Name="TabListBackground" IsTabStop="False" HorizontalAlignment="Stretch" ClickMode="Press" VerticalAlignment="Stretch" CornerRadius="0" Background="Transparent" BorderBrush="Transparent" Margin="0,40,0,0" Click="TabListBackground_Click" Visibility="Collapsed">
        </Button>
        <Grid x:Name="TabListGrid" Margin="0,40,0,0" ManipulationMode="TranslateX" ManipulationCompleted="TabListGrid_ManipulationCompleted" ManipulationStarted="TabListGrid_ManipulationStarted"  ManipulationDelta="TabListGrid_ManipulationDelta" VerticalAlignment="Stretch" HorizontalAlignment="Left" Visibility="Collapsed" Opacity="1">
            <Grid.Resources>
                <Storyboard x:Name="TabListStoryBoard">
                    <DoubleAnimation x:Name="TabListFlowIn" Storyboard.TargetName="TabListGridTransform" Storyboard.TargetProperty="X" From="0" To="0" Duration="0:0:0.4" >
                        <DoubleAnimation.EasingFunction>
                            <ExponentialEase Exponent="8" EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation x:Name="TabListOpacity" From="1" To="1" Storyboard.TargetName="TabListGrid" Storyboard.TargetProperty="Opacity" Duration="0:0:0.1" />
                </Storyboard>
            </Grid.Resources>
            <Grid.RenderTransform>
                <TranslateTransform x:Name="TabListGridTransform" X="0" Y="0"/>
            </Grid.RenderTransform>
            <Frame Name="TabListWindow" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
                <Grid AutomationProperties.Name="标签页列表">
                    <ListView HorizontalAlignment="Stretch" IsItemClickEnabled="True" ItemClick="TabListView_ItemClick" VerticalAlignment="Top" Margin="4,4,8,0" SelectionChanged="ListView_SelectionChanged" Name="ListView" >
                        <ListView.Transitions >
                            <TransitionCollection>
                                <RepositionThemeTransition x:DefaultBindMode="OneWay"/>
                            </TransitionCollection>
                        </ListView.Transitions>
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection>
                                <RepositionThemeTransition IsStaggeringEnabled="False"/>
                            </TransitionCollection>
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:Tab_List">
                                <Grid ToolTipService.ToolTip="{x:Bind Title}" AutomationProperties.Name="{x:Bind Title}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="关闭" Click="TabListCloseItem_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Image Source="{x:Bind iconSource}" Width="16" Height="16" Margin="0,2,8,2" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <TextBlock VerticalAlignment="Center" FontFamily="HarmonyOS Sans SC" Text="{x:Bind Title}" FontSize="12" Margin="24,2,0,2"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                     </ListView>
                </Grid>
            </Frame>
            <AppBarSeparator Name="TabListSeparateBar" Visibility="Collapsed" VerticalAlignment="Stretch" HorizontalAlignment="Right" Margin="-8,-8,-3,-8"/>
        </Grid>

        <Frame Name="SettingsFrame" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,0,0" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" Opacity="0" >
            <Frame.Resources>
                <Storyboard x:Name="SettingsStoryBoard">
                    <DoubleAnimation x:Name="SettingsStoryBoardDoubleAnimation" From="0" To="1" Storyboard.TargetName="SettingsFrame" Storyboard.TargetProperty="Opacity" Duration="0:0:0.2" />
                </Storyboard>
            </Frame.Resources>
        </Frame>
        <StackPanel x:Name="SettingsBackControl" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" Margin="2,2,0,0">
            <Button AutomationProperties.Name="返回" Name="SettingsBack" Click="SettingsBack_Click" ToolTipService.ToolTip="返回" Background="Transparent" BorderBrush="Transparent" FontFamily="Segoe Fluent Icons" Content="&#xE112;" FontSize="14" Height="36" Width="38">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Escape"/>
                </Button.KeyboardAccelerators>
            </Button>
        </StackPanel>
    </Grid>
</Page>
